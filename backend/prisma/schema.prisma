// PG Delivery — schema Prisma (PostgreSQL 16 + PostGIS)
// No monólito modular cada bounded context usa um schema Postgres próprio (multiSchema).
// Ao extrair um microsserviço, o bloco do contexto vai junto para o novo repositório.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pg_trgm, citext]
  schemas    = ["identity", "restaurant", "catalog", "ordering", "delivery", "payment", "marketing", "platform"]
}

// ───────────────────────────── IDENTITY (Auth + User) ─────────────────────────────

enum UserRole {
  CUSTOMER
  COURIER
  MERCHANT
  ADMIN
  SUPPORT

  @@schema("identity")
}

enum UserStatus {
  ACTIVE
  PENDING
  BLOCKED
  DELETED

  @@schema("identity")
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String?    @unique @db.Citext
  phone         String?    @unique // E.164
  passwordHash  String?    @map("password_hash")
  name          String
  cpfEncrypted  String?    @map("cpf_encrypted") // AES-256-GCM (envelope KMS)
  cpfHash       String?    @unique @map("cpf_hash") // HMAC-SHA256 para busca/unicidade
  roles         UserRole[] @default([CUSTOMER])
  status        UserStatus @default(ACTIVE)
  mfaSecret     String?    @map("mfa_secret")
  emailVerified Boolean    @default(false) @map("email_verified")
  phoneVerified Boolean    @default(false) @map("phone_verified")
  avatarUrl     String?    @map("avatar_url")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  identities    OAuthIdentity[]
  refreshTokens RefreshToken[]
  addresses     Address[]
  paymentMethods PaymentMethod[]
  favorites     Favorite[]
  consents      Consent[]
  courier       Courier?
  orders        Order[]
  reviews       Review[]
  loyalty       LoyaltyAccount?
  memberships   RestaurantMember[]

  @@map("users")
  @@schema("identity")
}

model OAuthIdentity {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  provider   String // google | apple
  providerId String   @map("provider_id")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("oauth_identities")
  @@schema("identity")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid // rotação com detecção de reuso
  tokenHash  String    @unique @map("token_hash")
  deviceId   String?   @map("device_id")
  userAgent  String?   @map("user_agent")
  ip         String?
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
  @@schema("identity")
}

model Address {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  label        String // Casa, Trabalho
  street       String
  number       String
  complement   String?
  district     String
  city         String
  state        String   @db.Char(2)
  zipCode      String   @map("zip_code")
  latitude     Float
  longitude    Float
  reference    String?
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
  @@schema("identity")
}

model PaymentMethod {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  gateway       String // asaas | mercadopago | stripe
  gatewayToken  String   @map("gateway_token") // nunca armazenar PAN (PCI DSS)
  brand         String
  last4         String   @db.Char(4)
  expMonth      Int      @map("exp_month")
  expYear       Int      @map("exp_year")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payment_methods")
  @@schema("identity")
}

model Favorite {
  userId       String     @map("user_id") @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([userId, restaurantId])
  @@map("favorites")
  @@schema("identity")
}

model Consent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  purpose   String // marketing_push, marketing_email, analytics, location
  granted   Boolean
  version   String // versão do termo
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("consents")
  @@schema("identity")
}

enum CourierStatus {
  PENDING_DOCS
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED

  @@schema("identity")
}

enum VehicleType {
  BIKE
  MOTORCYCLE
  CAR
  WALK

  @@schema("identity")
}

model Courier {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @unique @map("user_id") @db.Uuid
  status        CourierStatus @default(PENDING_DOCS)
  vehicle       VehicleType
  licensePlate  String?       @map("license_plate")
  pixKey        String?       @map("pix_key")
  rating        Decimal       @default(5.0) @db.Decimal(3, 2)
  acceptanceRate Decimal      @default(1.0) @map("acceptance_rate") @db.Decimal(4, 3)
  completedDeliveries Int     @default(0) @map("completed_deliveries")
  isOnline      Boolean       @default(false) @map("is_online")
  approvedAt    DateTime?     @map("approved_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  user          User          @relation(fields: [userId], references: [id])
  documents     CourierDocument[]
  deliveries    Delivery[]
  payouts       Payout[]

  @@index([status, isOnline])
  @@map("couriers")
  @@schema("identity")
}

model CourierDocument {
  id         String   @id @default(uuid()) @db.Uuid
  courierId  String   @map("courier_id") @db.Uuid
  type       String // CNH, CRLV, SELFIE, COMPROVANTE_RESIDENCIA
  s3Key      String   @map("s3_key") // bucket privado + SSE-KMS
  status     String   @default("PENDING")
  reviewedBy String?  @map("reviewed_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  courier    Courier  @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@map("courier_documents")
  @@schema("identity")
}

// ───────────────────────────── RESTAURANT ─────────────────────────────

model Restaurant {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique
  name            String
  legalName       String   @map("legal_name")
  cnpj            String   @unique
  description     String?
  logoUrl         String?  @map("logo_url")
  bannerUrl       String?  @map("banner_url")
  cuisineIds      String[] @map("cuisine_ids")
  priceLevel      Int      @default(2) @map("price_level") // 1..4
  latitude        Float
  longitude       Float
  addressLine     String   @map("address_line")
  city            String
  state           String   @db.Char(2)
  rating          Decimal  @default(0) @db.Decimal(3, 2)
  ratingCount     Int      @default(0) @map("rating_count")
  minOrderCents   Int      @default(0) @map("min_order_cents")
  deliveryFeeCents Int     @default(0) @map("delivery_fee_cents")
  avgPrepMinutes  Int      @default(20) @map("avg_prep_minutes")
  commissionBps   Int      @default(1200) @map("commission_bps") // 12,00%
  isOpen          Boolean  @default(false) @map("is_open")
  isActive        Boolean  @default(true) @map("is_active")
  sponsoredUntil  DateTime? @map("sponsored_until")
  gatewayAccountId String? @map("gateway_account_id") // subconta para split
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  openingHours    OpeningHour[]
  zones           DeliveryZone[]
  members         RestaurantMember[]
  categories      Category[]
  products        Product[]
  orders          Order[]
  favorites       Favorite[]
  reviews         Review[]

  @@index([city, isActive, isOpen])
  @@index([latitude, longitude])
  @@map("restaurants")
  @@schema("restaurant")
}

model RestaurantMember {
  restaurantId String     @map("restaurant_id") @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  role         String // OWNER | MANAGER | OPERATOR
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([restaurantId, userId])
  @@map("restaurant_members")
  @@schema("restaurant")
}

model OpeningHour {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  weekday      Int // 0=domingo
  opensAt      String     @map("opens_at") // "11:00"
  closesAt     String     @map("closes_at") // "23:30" (pode cruzar meia-noite)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, weekday])
  @@map("opening_hours")
  @@schema("restaurant")
}

model DeliveryZone {
  id            String     @id @default(uuid()) @db.Uuid
  restaurantId  String     @map("restaurant_id") @db.Uuid
  name          String
  // Polígono PostGIS gerenciado via SQL bruto (Prisma não tipa geometry)
  area          Unsupported("geometry(Polygon, 4326)")?
  feeCents      Int        @map("fee_cents")
  etaExtraMin   Int        @default(0) @map("eta_extra_min")
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("delivery_zones")
  @@schema("restaurant")
}

// ───────────────────────────── CATALOG ─────────────────────────────

model Category {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  name         String
  position     Int        @default(0)
  isActive     Boolean    @default(true) @map("is_active")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products     Product[]

  @@index([restaurantId, position])
  @@map("categories")
  @@schema("catalog")
}

model Product {
  id            String     @id @default(uuid()) @db.Uuid
  restaurantId  String     @map("restaurant_id") @db.Uuid
  categoryId    String     @map("category_id") @db.Uuid
  name          String
  description   String?
  imageUrl      String?    @map("image_url")
  priceCents    Int        @map("price_cents")
  promoPriceCents Int?     @map("promo_price_cents")
  serves        Int        @default(1)
  tags          String[] // vegano, sem_gluten, picante
  stockQty      Int?       @map("stock_qty") // null = ilimitado
  isAvailable   Boolean    @default(true) @map("is_available")
  isFeatured    Boolean    @default(false) @map("is_featured")
  position      Int        @default(0)
  version       Int        @default(1) // lock otimista
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category      Category   @relation(fields: [categoryId], references: [id])
  optionGroups  OptionGroup[]

  @@index([restaurantId, categoryId, position])
  @@index([restaurantId, isFeatured])
  @@map("products")
  @@schema("catalog")
}

model OptionGroup {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  name       String // "Escolha o ponto da carne"
  minSelect  Int      @default(0) @map("min_select")
  maxSelect  Int      @default(1) @map("max_select")
  position   Int      @default(0)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  options    Option[]

  @@map("option_groups")
  @@schema("catalog")
}

model Option {
  id          String      @id @default(uuid()) @db.Uuid
  groupId     String      @map("group_id") @db.Uuid
  name        String
  priceCents  Int         @default(0) @map("price_cents")
  isAvailable Boolean     @default(true) @map("is_available")
  group       OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("options")
  @@schema("catalog")
}

// ───────────────────────────── ORDERING ─────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  DELIVERED
  CANCELLED

  @@schema("ordering")
}

// Em produção: particionada por RANGE(created_at) mensal (ver docs/03-banco-de-dados.md)
model Order {
  id               String      @id @default(uuid()) @db.Uuid
  code             String      @unique // "PG-7F3K2" exibido ao cliente
  customerId       String      @map("customer_id") @db.Uuid
  restaurantId     String      @map("restaurant_id") @db.Uuid
  status           OrderStatus @default(PENDING_PAYMENT)
  subtotalCents    Int         @map("subtotal_cents")
  deliveryFeeCents Int         @map("delivery_fee_cents")
  serviceFeeCents  Int         @default(0) @map("service_fee_cents")
  discountCents    Int         @default(0) @map("discount_cents")
  totalCents       Int         @map("total_cents")
  couponCode       String?     @map("coupon_code")
  paymentMethod    String      @map("payment_method") // PIX | CREDIT | DEBIT | GOOGLE_PAY | APPLE_PAY | WALLET
  notes            String?
  deliveryAddress  Json        @map("delivery_address") // snapshot imutável
  deliveryCode     String      @map("delivery_code") @db.Char(4)
  estimatedAt      DateTime?   @map("estimated_at")
  idempotencyKey   String      @unique @map("idempotency_key")
  version          Int         @default(1)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  customer         User        @relation(fields: [customerId], references: [id])
  restaurant       Restaurant  @relation(fields: [restaurantId], references: [id])
  items            OrderItem[]
  history          OrderStatusHistory[]
  delivery         Delivery?
  payment          Payment?
  review           Review?

  @@index([customerId, createdAt(sort: Desc)])
  @@index([restaurantId, status, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("orders")
  @@schema("ordering")
}

model OrderItem {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  productName    String @map("product_name") // snapshot
  unitPriceCents Int    @map("unit_price_cents")
  quantity       Int
  options        Json // [{groupName, name, priceCents}]
  notes          String?
  totalCents     Int    @map("total_cents")
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
  @@schema("ordering")
}

model OrderStatusHistory {
  id        BigInt      @id @default(autoincrement())
  orderId   String      @map("order_id") @db.Uuid
  from      OrderStatus?
  to        OrderStatus
  actor     String // customer:<id> | merchant:<id> | system
  reason    String?
  createdAt DateTime    @default(now()) @map("created_at")
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
  @@schema("ordering")
}

model Review {
  id             String     @id @default(uuid()) @db.Uuid
  orderId        String     @unique @map("order_id") @db.Uuid
  customerId     String     @map("customer_id") @db.Uuid
  restaurantId   String     @map("restaurant_id") @db.Uuid
  restaurantStars Int       @map("restaurant_stars")
  courierStars   Int?       @map("courier_stars")
  comment        String?
  reply          String?
  createdAt      DateTime   @default(now()) @map("created_at")
  order          Order      @relation(fields: [orderId], references: [id])
  customer       User       @relation(fields: [customerId], references: [id])
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId, createdAt(sort: Desc)])
  @@map("reviews")
  @@schema("ordering")
}

// ───────────────────────────── DELIVERY ─────────────────────────────

enum DeliveryStatus {
  SEARCHING
  OFFERED
  ASSIGNED
  AT_PICKUP
  PICKED_UP
  AT_DROPOFF
  DELIVERED
  FAILED

  @@schema("delivery")
}

model Delivery {
  id            String         @id @default(uuid()) @db.Uuid
  orderId       String         @unique @map("order_id") @db.Uuid
  courierId     String?        @map("courier_id") @db.Uuid
  status        DeliveryStatus @default(SEARCHING)
  pickupLat     Float          @map("pickup_lat")
  pickupLng     Float          @map("pickup_lng")
  dropoffLat    Float          @map("dropoff_lat")
  dropoffLng    Float          @map("dropoff_lng")
  distanceMeters Int?          @map("distance_meters")
  routePolyline String?        @map("route_polyline")
  courierFeeCents Int          @map("courier_fee_cents")
  tipCents      Int            @default(0) @map("tip_cents")
  assignedAt    DateTime?      @map("assigned_at")
  pickedUpAt    DateTime?      @map("picked_up_at")
  deliveredAt   DateTime?      @map("delivered_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  order         Order          @relation(fields: [orderId], references: [id])
  courier       Courier?       @relation(fields: [courierId], references: [id])
  offers        DeliveryOffer[]

  @@index([courierId, createdAt(sort: Desc)])
  @@index([status])
  @@map("deliveries")
  @@schema("delivery")
}

model DeliveryOffer {
  id          String    @id @default(uuid()) @db.Uuid
  deliveryId  String    @map("delivery_id") @db.Uuid
  courierId   String    @map("courier_id") @db.Uuid
  score       Float
  response    String? // ACCEPTED | REJECTED | EXPIRED
  expiresAt   DateTime  @map("expires_at")
  respondedAt DateTime? @map("responded_at")
  delivery    Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([courierId, expiresAt])
  @@map("delivery_offers")
  @@schema("delivery")
}

// Série temporal: particionar por dia; retenção 90 dias (LGPD: minimização)
model CourierLocation {
  id         BigInt   @id @default(autoincrement())
  courierId  String   @map("courier_id") @db.Uuid
  deliveryId String?  @map("delivery_id") @db.Uuid
  lat        Float
  lng        Float
  heading    Float?
  speedKmh   Float?   @map("speed_kmh")
  recordedAt DateTime @map("recorded_at")

  @@index([courierId, recordedAt(sort: Desc)])
  @@map("courier_locations")
  @@schema("delivery")
}

// ───────────────────────────── PAYMENT ─────────────────────────────

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CHARGEBACK

  @@schema("payment")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @unique @map("order_id") @db.Uuid
  gateway         String
  gatewayChargeId String?       @unique @map("gateway_charge_id")
  method          String
  status          PaymentStatus @default(PENDING)
  amountCents     Int           @map("amount_cents")
  pixQrCode       String?       @map("pix_qr_code")
  pixExpiresAt    DateTime?     @map("pix_expires_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  order           Order         @relation(fields: [orderId], references: [id])
  splits          PaymentSplit[]
  refunds         Refund[]

  @@index([status, createdAt])
  @@map("payments")
  @@schema("payment")
}

model PaymentSplit {
  id          String  @id @default(uuid()) @db.Uuid
  paymentId   String  @map("payment_id") @db.Uuid
  recipient   String // RESTAURANT:<id> | COURIER:<id> | PLATFORM
  amountCents Int     @map("amount_cents")
  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_splits")
  @@schema("payment")
}

model Refund {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @map("payment_id") @db.Uuid
  amountCents Int      @map("amount_cents")
  reason      String
  status      String   @default("PENDING")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  payment     Payment  @relation(fields: [paymentId], references: [id])

  @@map("refunds")
  @@schema("payment")
}

// Razão contábil de partidas dobradas: base da conciliação
model LedgerEntry {
  id          BigInt   @id @default(autoincrement())
  txId        String   @map("tx_id") @db.Uuid // agrupa débito/crédito
  account     String // receivable:gateway, payable:restaurant:<id>, revenue:commission...
  debitCents  Int      @default(0) @map("debit_cents")
  creditCents Int      @default(0) @map("credit_cents")
  reference   String // order:<id> | refund:<id> | payout:<id>
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([account, createdAt])
  @@index([txId])
  @@map("ledger_entries")
  @@schema("payment")
}

model Payout {
  id          String   @id @default(uuid()) @db.Uuid
  courierId   String?  @map("courier_id") @db.Uuid
  restaurantId String? @map("restaurant_id") @db.Uuid
  amountCents Int      @map("amount_cents")
  status      String   @default("REQUESTED") // REQUESTED | PROCESSING | PAID | FAILED
  pixKey      String?  @map("pix_key")
  requestedAt DateTime @default(now()) @map("requested_at")
  paidAt      DateTime? @map("paid_at")
  courier     Courier? @relation(fields: [courierId], references: [id])

  @@index([status])
  @@map("payouts")
  @@schema("payment")
}

// ───────────────────────────── MARKETING (Coupon + Loyalty) ─────────────────────────────

model Coupon {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  description     String
  type            String // PERCENT | FIXED | FREE_DELIVERY
  value           Int // bps para PERCENT, centavos para FIXED
  maxDiscountCents Int?    @map("max_discount_cents")
  minOrderCents   Int      @default(0) @map("min_order_cents")
  restaurantId    String?  @map("restaurant_id") @db.Uuid // null = plataforma
  fundedBy        String   @default("PLATFORM") @map("funded_by") // PLATFORM | RESTAURANT | SHARED
  usageLimit      Int?     @map("usage_limit")
  perUserLimit    Int      @default(1) @map("per_user_limit")
  firstOrderOnly  Boolean  @default(false) @map("first_order_only")
  startsAt        DateTime @map("starts_at")
  endsAt          DateTime @map("ends_at")
  isActive        Boolean  @default(true) @map("is_active")
  redemptions     CouponRedemption[]

  @@index([restaurantId, isActive])
  @@map("coupons")
  @@schema("marketing")
}

model CouponRedemption {
  id         String   @id @default(uuid()) @db.Uuid
  couponId   String   @map("coupon_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  orderId    String   @unique @map("order_id") @db.Uuid
  discountCents Int   @map("discount_cents")
  createdAt  DateTime @default(now()) @map("created_at")
  coupon     Coupon   @relation(fields: [couponId], references: [id])

  @@index([couponId, userId])
  @@map("coupon_redemptions")
  @@schema("marketing")
}

model LoyaltyAccount {
  userId        String @id @map("user_id") @db.Uuid
  points        Int    @default(0)
  cashbackCents Int    @default(0) @map("cashback_cents")
  tier          String @default("PEQUENO") // PEQUENO | MEDIO | GIGANTE
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger        LoyaltyLedger[]

  @@map("loyalty_accounts")
  @@schema("marketing")
}

model LoyaltyLedger {
  id        BigInt         @id @default(autoincrement())
  userId    String         @map("user_id") @db.Uuid
  delta     Int
  reason    String // order:<id> | redeem | expire
  expiresAt DateTime?      @map("expires_at")
  createdAt DateTime       @default(now()) @map("created_at")
  account   LoyaltyAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("loyalty_ledger")
  @@schema("marketing")
}

// ───────────────────────────── PLATFORM (Outbox, Notification, Admin) ─────────────────────────────

model OutboxEvent {
  id            String    @id @db.Uuid // = eventId
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  topic         String
  type          String
  payload       Json
  headers       Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")
  attempts      Int       @default(0)

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
  @@schema("platform")
}

model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([eventId, consumer])
  @@map("processed_events")
  @@schema("platform")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  channel   String // PUSH | SMS | EMAIL | IN_APP
  template  String
  payload   Json
  status    String    @default("QUEUED")
  sentAt    DateTime? @map("sent_at")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
  @@schema("platform")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String   @map("actor_id")
  action     String // finance.refund.create, restaurant.block...
  entity     String
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_log")
  @@schema("platform")
}

model Setting {
  key       String   @id
  value     Json
  updatedBy String   @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
  @@schema("platform")
}

model Banner {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  imageUrl  String   @map("image_url")
  deeplink  String
  city      String?
  position  Int      @default(0)
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  isActive  Boolean  @default(true) @map("is_active")

  @@map("banners")
  @@schema("platform")
}
